# AICredits.in LLM Configuration
AICREDITS_API_KEY=your_aicredits_api_key_here
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_MODEL=gemini-2.5-flash

# Video Rendering Defaults
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium

# Audio Settings
AUDIO_BITRATE=192k

# Cache & Paths
CACHE_DIR=cache
OUTPUT_DIR=output
